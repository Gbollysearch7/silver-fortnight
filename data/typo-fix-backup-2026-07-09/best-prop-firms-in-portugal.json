: 600;\n        width: 18%;\n    }\n    th:nth-child(n+3) { width: 16%; }\n    td {\n        padding: 10px 8px;\n        font-size: 12px;\n        color: #e8eaed;\n        border-bottom: 1px solid #3c4043;\n        word-wrap: break-word;\n    }\n    td:nth-child(2) {\n        background: rgba(26, 58, 82, 0.15);\n        border-left: 3px solid #6eb5ff;\n    }\n    .checkmark {\n        display: inline-flex;\n        align-items: center;\n        padding: 3px 8px;\n        background: rgba(129, 201, 149, 0.15);\n        border-radius: 4px;\n        color: #81c995;\n        font-size: 11px;\n    }\n    .checkmark::before { content: '✓'; margin-right: 3px; }\n    .cross {\n        display: inline-flex;\n        align-items: center;\n        padding: 3px 8px;\n        background: rgba(242, 139, 130, 0.15);\n        border-radius: 4px;\n        color: #f28b82;\n        font-size: 11px;\n    }\n    .cross::before { content: '✕'; margin-right: 3px; }\n    .blue-check {\n        display: inline-flex;\n        align-items: center;\n        padding: 4px 10px;\n        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);\n        border-radius: 4px;\n        color: #ffffff;\n        font-size: 11px;\n        font-weight: 600;\n    }\n    .blue-check::before { content: '✓'; margin-right: 3px; }\n    .badge {\n        display: inline-block;\n        background: #1a3a52;\n        color: #6eb5ff;\n        padding: 2px 5px;\n        border-radius: 3px;\n        font-size: 8px;\n        font-weight: 600;\n        text-transform: uppercase;\n        margin-left: 4px;\n    }\n    .star { color: #fdd663; }\n    .cta-box {\n        background: linear-gradient(135deg, #4250eb 0%, #3240d9 100%);\n        padding: 24px;\n        border-radius: 12px;\n        text-align: center;\n        margin: 32px 0;\n    }\n    .cta-button {\n        display: inline-block;\n        background: #ffffff;\n        color: #4250eb;\n        padding: 14px 32px;\n        border-radius: 8px;\n        t